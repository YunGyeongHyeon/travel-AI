{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/generate-itinerary.ts": {
      "maxDuration": 60
    },
    "api/regenerate-spot.ts": {
      "maxDuration": 60
    },
    "api/trip-chat.ts": {
      "maxDuration": 60
    }
  }
}
